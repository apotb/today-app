TICKETMASTER_API_KEY=your_ticketmaster_key
EVENTBRITE_API_TOKEN=your_eventbrite_token
GOOGLE_PLACES_API_KEY=your_google_places_key

# Frontend (Vercel / production build): absolute base for API calls. Must match how Express is
# exposed (paths are /api/...). Example: https://your-service.up.railway.app/api
# VITE_API_BASE=https://example.com/api

# Server (Render/Railway/etc.): optional SQLite path when using a persistent volume
# TODAY_DB_PATH=/mnt/data/today.db
